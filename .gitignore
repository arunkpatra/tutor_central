# macOS
.DS_Store

# Xcode (the project is generated by XcodeGen, D9)
ios/*.xcodeproj
ios/*.xcworkspace
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
ios/**/.build/
ios/**/.swiftpm/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Bun and Node
node_modules/
.turbo/
bun.lockb.tmp

# Vercel
.vercel/

# Supabase local
supabase/.branches/
supabase/.temp/

# Secrets: never committed
.env
.env.*
!.env.example

# Scratch screenshots (the kept ones live on the branch pr-shots)
.shots/

# bun check step cache
.check-cache/

# Local build config (copy of ios/Config/Local.xcconfig.example)
ios/Config/Local.xcconfig

# Next.js (web/, D44)
web/.next/
web/out/
web/*.tsbuildinfo
# Next writes it on every build and typegen; it imports .next/types, so it cannot be committed
web/next-env.d.ts
