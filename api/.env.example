# Set in Vercel (and api/.env.local for `bun run dev`); never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The platform's identity (D83): the observability client and the worker only, never a tutor's call. Locally the
# SERVICE_ROLE_KEY of `supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=
# The bearer pg_cron and the enqueue trigger send to /jobs/* (D85); the same value as GitHub's Production WORKER_SECRET,
# which the deploy writes into Vault. Locally any value (the runbook's section 12 uses "local").
WORKER_SECRET=
ANTHROPIC_API_KEY=
# The Sign in with Apple key (.p8), its id and the team id (D38). In Vercel the .p8's whole text; in .env.local on one
# line with \n for its newlines. APPLE_FAKE=1 skips Apple locally (a hand run's deletion costs nothing); never in Vercel.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIGNIN_KEY=
# APNs (D88): the push key (.p8), its id, the team id and the topic (in.tutorcentral.app). In Vercel the .p8's whole text;
# in .env.local on one line with \n for its newlines. Without them a local run sends to a pusher in memory.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
# The alerts job's email (D95): Resend's sending key and the address alerts go to. Production must have both; a local run
# without RESEND_API_KEY logs the email instead.
RESEND_API_KEY=
ALERT_EMAIL=
# AI_FAKE=1 answers from the fake instead of Claude (local runs that must not cost money); never set in Vercel.
# AI_MODEL_<WORK_TYPE> overrides the model for one kind of work at deploy (D67): the work types are api/models.json's
# "work" keys upper-cased (AI_MODEL_CHECK_PAPER, AI_MODEL_SHEET_FROM_6). A value that is not one of its models stops the
# API at start, so the deploy's smoke fails.
