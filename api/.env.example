# Set in Vercel (and api/.env.local for `bun run dev`); never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# The Sign in with Apple key (.p8), its id and the team id (D38). In Vercel the .p8's whole text; in .env.local on one
# line with \n for its newlines. APPLE_FAKE=1 skips Apple locally (a hand run's deletion costs nothing); never in Vercel.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIGNIN_KEY=
# AI_FAKE=1 answers from the fake instead of Claude (local runs that must not cost money); never set in Vercel.
# The service role key is never used by this API.
# AI_MODEL_<WORK_TYPE> overrides the model for one kind of work at deploy (D67): the work types are api/models.json's
# "work" keys upper-cased (AI_MODEL_CHECK_PAPER, AI_MODEL_SHEET_FROM_6). A value that is not one of its models stops the
# API at start, so the deploy's smoke fails.
